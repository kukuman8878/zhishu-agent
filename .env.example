# ===== 智数主链路（数据分析/意图判别/闲聊）=====
# 兼容 OpenAI 接口的大模型 API Key（默认硅基流动 https://api.siliconflow.cn/v1）
LLM_API_KEY=your_real_llm_api_key

# ===== 进程内文档问答引擎（app/rag_engine/）=====
# 文档引擎走硅基流动（与智数主链路独立计量，可在 conf/app_config.yaml 切换）
SILICONFLOW_API_KEY=your_real_doc_engine_api_key
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_BINDING_HOST=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
LLM_BINDING_HOST=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
LLM_MODEL_VISUAL=Qwen/Qwen3-VL-30B-A3B-Instruct

# ===== 文档引擎数据/索引路径（可指向本地 data/ 目录）=====
# 索引目录：进程内 doc/hybrid 问答运行时装载（默认仓库内 data/doc_index，不进 git）
INDEX_DIR=./data/doc_index

# ===== 文档引擎检索/Agent/视觉超参 =====
DOC_TOPK=2
PAGE_RECALL_TOPK=24
PAGE_TOPK_DEFAULT=5
PAGE_TOPK_VISUAL=8
PAGE_TOPK_TEXT=6
RERANK_WEIGHT=0.7
# 重排分门：证据里最高 bge-reranker 相关分低于该值时拒绝作答（防低相关页编造）
RERANK_MIN_SCORE=0.30
# 可溯源门：答案必须能落到具体页码，否则拒绝作答
REQUIRE_CITATION=1
MAX_AGENT_ROUNDS=2
IMG_MAX_COUNT=8
NO_IMAGE_MODE=0
CTX_PAGE_CHARS=3000
CTX_TOTAL_CHARS=12000
ANSWER_MAX_TOKENS=1500
IMAGE_STRATEGY=full_plus_crop
VLM_CACHE=1
CACHE_DIR=./data/vlm_cache
REGION_DPI=300
CROP_UPSCALE=2
VERIFY_MAX_ROUNDS=2
FULL_IMAGE_MAX_DIM=2048
